# Entity: member

main: kit: entity: member: {

  alias: field: {}

  fields: {
    avatarUrl: {
      h: "Avatar Url"
      n: "avatarUrl"
      r: false
      t: "`$STRING`"
    }
    email: {
      h: "Email"
      n: "email"
      r: false
      t: "`$STRING`"
    }
    fullName: {
      h: "Full Name"
      n: "fullName"
      r: false
      t: "`$STRING`"
    }
    joinedAt: {
      h: "Joined At"
      n: "joinedAt"
      r: false
      sh: "Human-readable relative time, not an ISO timestamp."
      t: "`$STRING`"
    }
    role: {
      h: "Role"
      n: "role"
      r: true
      t: "`$STRING`"
    }
    userId: {
      fo: "uuid"
      h: "User Id"
      n: "userId"
      r: true
      t: "`$STRING`"
    }
    username: {
      h: "Username"
      n: "username"
      r: false
      t: "`$STRING`"
    }
  }

  name: "member"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/dashboard/projects/members"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "project_id"
                or: "projectId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/dashboard/projects/members"
          q: {
            exist: [
              "project_id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "dashboard"
            }
            {
              lit: "projects"
            }
            {
              lit: "members"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.members`"
          }
        }
      ]
    }
  }



}

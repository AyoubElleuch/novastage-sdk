# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 4
  metrics: count: path: 4
  metrics: count: method: 5

  entity: account_setting: {
    path: "/api/dashboard/settings": {
      op: load: method: *GET
    }
  }

  entity: member: {
    path: "/api/dashboard/projects/members": {
      op: list: method: *GET
      op: list: transform: res: *("`body.members`")|top
    }
  }

  entity: message_result: {
    path: "/api/dashboard/projects/delete": {
      op: create: method: *POST
    }
  }

  entity: project: {
    path: "/api/dashboard/projects": {
      op: create: method: *POST
      op: create: transform: res: *("`body.project`")|top
      op: list: method: *GET
      op: list: transform: res: *("`body.projects`")|top
    }
  }

}
# BasicAccountSettingFlow

main: kit: flow: BasicAccountSettingFlow:
{
  entity: "account_setting",
  kind: "basic",
  name: "BasicAccountSettingFlow",
  step: [
    {
      i: {
        ref: "account_setting_ref01",
        srcdatavar: "account_setting_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccountSettingFlow"
}